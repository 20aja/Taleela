rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function playerPath(roomId, playerId) {
      return /databases/$(database)/documents/rooms/$(roomId)/players/$(playerId);
    }

    function avatarPath(roomId, avatarId) {
      return /databases/$(database)/documents/rooms/$(roomId)/avatars/$(avatarId);
    }

    function roomExists(roomId) {
      return exists(roomPath(roomId));
    }

    function roomData(roomId) {
      return get(roomPath(roomId)).data;
    }

    function roomDataAfter(roomId) {
      return getAfter(roomPath(roomId)).data;
    }

    function isMember(roomId) {
      return signedIn() && exists(playerPath(roomId, uid()));
    }

    function isHost(roomId) {
      return isMember(roomId) && roomData(roomId).hostId == uid();
    }

    function validAvatar(avatar) {
      return avatar is string
        && avatar.matches('^avatar-(0[1-9]|1[0-9]|20)$');
    }

    function validAvatarImage(image) {
      return image == null
        || (image is string
          && image.size() <= 60000
          && image.matches('^data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/=]+$'));
    }

    function validName(name) {
      return name is string && name.size() >= 1 && name.size() <= 20;
    }

    function validSettings(settings) {
      return settings is map
        && settings.keys().hasAll([
          'rounds', 'answerTime', 'selectionTime',
          'revealTime', 'resultsTime', 'maxPlayers'
        ])
        && settings.rounds is int
        && settings.rounds >= 3
        && settings.rounds <= 30
        && settings.answerTime is int
        && settings.answerTime >= 10
        && settings.answerTime <= 60
        && settings.selectionTime is int
        && settings.selectionTime >= 5
        && settings.selectionTime <= 20
        && settings.revealTime is int
        && settings.revealTime >= 8
        && settings.revealTime <= 60
        && settings.resultsTime is int
        && settings.resultsTime >= 3
        && settings.resultsTime <= 15
        && settings.maxPlayers is int
        && settings.maxPlayers >= 2
        && settings.maxPlayers <= 8;
    }

    function validRoomCreate(roomId) {
      let data = request.resource.data;
      return signedIn()
        && data.schemaVersion == 7
        && data.code == roomId
        && data.code is string
        && data.code.size() == 6
        && data.code.matches('^[A-Z0-9]{6}$')
        && data.hostId == uid()
        && validName(data.hostName)
        && validAvatar(data.hostAvatar)
        && validAvatarImage(data.hostAvatarImage)
        && data.status == 'waiting'
        && data.isPublic is bool
        && data.createdAt is timestamp
        && data.lastActivityAt is timestamp
        && data.expiresAt is timestamp
        && data.playerCount == 1
        && validSettings(data.settings)
        && data.categories is list
        && data.categories.size() == 0
        && data.usedQuestionIds is list
        && data.usedFactKeys is list
        && data.currentRoundId == null
        && existsAfter(playerPath(roomId, uid()))
        && getAfter(playerPath(roomId, uid())).data.avatar == data.hostAvatar
        && getAfter(playerPath(roomId, uid())).data.avatarImage == data.hostAvatarImage
        && (
          data.hostAvatarImage != null
          || (
            existsAfter(avatarPath(roomId, data.hostAvatar))
            && getAfter(avatarPath(roomId, data.hostAvatar)).data.playerId == uid()
          )
        );
    }

    function immutableRoomFieldsUnchanged() {
      return request.resource.data.schemaVersion == resource.data.schemaVersion
        && request.resource.data.code == resource.data.code
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function joiningRoom(roomId) {
      return signedIn()
        && resource.data.schemaVersion == 7
        && resource.data.status == 'waiting'
        && !exists(playerPath(roomId, uid()))
        && existsAfter(playerPath(roomId, uid()))
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['playerCount', 'lastActivityAt', 'expiresAt'])
        && request.resource.data.playerCount == resource.data.playerCount + 1
        && request.resource.data.playerCount <= resource.data.settings.maxPlayers
        && request.resource.data.lastActivityAt is timestamp
        && request.resource.data.expiresAt is timestamp;
    }

    function leavingRoom(roomId) {
      return isMember(roomId)
        && resource.data.hostId != uid()
        && !existsAfter(playerPath(roomId, uid()))
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['playerCount', 'lastActivityAt'])
        && request.resource.data.playerCount == resource.data.playerCount - 1
        && request.resource.data.playerCount >= 0
        && request.resource.data.lastActivityAt is timestamp;
    }

    function oldHostIsStale(roomId) {
      let oldHost = resource.data.hostId;
      return !(oldHost is string)
        || !exists(/databases/$(database)/documents/rooms/$(roomId)/presence/$(oldHost))
        || get(/databases/$(database)/documents/rooms/$(roomId)/presence/$(oldHost)).data.lastSeen
          < request.time - duration.value(90, 's');
    }

    function takingOverStaleHost(roomId) {
      return isMember(roomId)
        && resource.data.hostId != uid()
        && request.resource.data.hostId == uid()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['hostId', 'hostName', 'hostAvatar', 'hostAvatarImage', 'lastActivityAt'])
        && validName(request.resource.data.hostName)
        && validAvatar(request.resource.data.hostAvatar)
        && validAvatarImage(request.resource.data.hostAvatarImage)
        && oldHostIsStale(roomId);
    }

    match /rooms/{roomId} {
      // Signed-in users need room metadata to join by code and list public rooms.
      allow read: if signedIn();
      allow create: if validRoomCreate(roomId);

      allow update: if immutableRoomFieldsUnchanged()
        && (
          isHost(roomId)
          || joiningRoom(roomId)
          || leavingRoom(roomId)
          || takingOverStaleHost(roomId)
        );

      allow delete: if isHost(roomId);

      match /players/{playerId} {
        function validPlayerCreate() {
          let data = request.resource.data;
          let room = roomDataAfter(roomId);
          return signedIn()
            && playerId == uid()
            && room.schemaVersion == 7
            && room.status == 'waiting'
            && data.keys().hasAll([
              'id', 'name', 'avatar', 'avatarImage', 'ready', 'score',
              'correctGuesses', 'fooledPlayers',
              'replayRequested', 'returnRequested', 'joinedAt'
            ])
            && data.keys().hasOnly([
              'id', 'name', 'avatar', 'avatarImage', 'ready', 'score',
              'correctGuesses', 'fooledPlayers',
              'replayRequested', 'returnRequested', 'joinedAt'
            ])
            && data.id == uid()
            && validName(data.name)
            && validAvatar(data.avatar)
            && validAvatarImage(data.avatarImage)
            && data.ready is bool
            && data.ready == (room.hostId == uid())
            && data.score == 0
            && data.correctGuesses == 0
            && data.fooledPlayers == 0
            && data.replayRequested == false
            && data.returnRequested == false
            && data.joinedAt is timestamp
            && (
              data.avatarImage != null
              || (
                existsAfter(avatarPath(roomId, data.avatar))
                && getAfter(avatarPath(roomId, data.avatar)).data.playerId == uid()
              )
            );
        }

        function validOwnUpdate() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();
          let room = roomData(roomId);
          return playerId == uid()
            && changed.hasOnly(['name', 'avatar', 'avatarImage', 'ready', 'replayRequested', 'returnRequested'])
            && request.resource.data.id == resource.data.id
            && request.resource.data.joinedAt == resource.data.joinedAt
            && request.resource.data.score == resource.data.score
            && request.resource.data.correctGuesses == resource.data.correctGuesses
            && request.resource.data.fooledPlayers == resource.data.fooledPlayers
            && validName(request.resource.data.name)
            && validAvatar(request.resource.data.avatar)
            && validAvatarImage(request.resource.data.avatarImage)
            && request.resource.data.ready is bool
            && request.resource.data.replayRequested is bool
            && request.resource.data.returnRequested is bool
            && (
              !changed.hasAny(['name', 'avatar', 'avatarImage', 'ready'])
              || room.status == 'waiting'
            )
            && (
              !changed.hasAny(['replayRequested', 'returnRequested'])
              || room.status == 'finished'
            )
            && (
              request.resource.data.avatarImage != null
              || (
                existsAfter(avatarPath(roomId, request.resource.data.avatar))
                && getAfter(avatarPath(roomId, request.resource.data.avatar)).data.playerId == uid()
              )
            );
        }

        // A user may check only their own membership before joining. Collection
        // listing is available only after membership is established.
        allow get: if signedIn() && (playerId == uid() || isMember(roomId));
        allow list: if isMember(roomId);
        allow create: if validPlayerCreate();
        allow update: if isHost(roomId)
          || (isMember(roomId) && validOwnUpdate());
        allow delete: if isHost(roomId) || (playerId == uid() && isMember(roomId));
      }

      match /avatars/{avatarId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && validAvatar(avatarId)
          && request.resource.data.keys().hasAll(['playerId', 'reservedAt'])
          && request.resource.data.keys().hasOnly(['playerId', 'reservedAt'])
          && request.resource.data.playerId == uid()
          && request.resource.data.reservedAt is timestamp
          && existsAfter(playerPath(roomId, uid()))
          && getAfter(playerPath(roomId, uid())).data.avatar == avatarId
          && getAfter(playerPath(roomId, uid())).data.avatarImage == null;
        allow update: if false;
        allow delete: if signedIn()
          && (resource.data.playerId == uid() || isHost(roomId));
      }

      match /presence/{playerId} {
        allow read: if isMember(roomId);
        allow create, update: if signedIn()
          && playerId == uid()
          && request.resource.data.keys().hasAll(['id', 'lastSeen'])
          && request.resource.data.keys().hasOnly(['id', 'lastSeen'])
          && request.resource.data.id == uid()
          && request.resource.data.lastSeen is timestamp
          && (
            exists(playerPath(roomId, uid()))
            || existsAfter(playerPath(roomId, uid()))
          );
        allow delete: if signedIn()
          && (playerId == uid() || isHost(roomId));
      }

      match /rounds/{roundId} {
        function parentRoom() {
          return roomData(roomId);
        }

        function chooserCategoryUpdate() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();
          return isMember(roomId)
            && parentRoom().status == 'playing'
            && parentRoom().currentRoundId == roundId
            && resource.data.phase == 'category_selection'
            && resource.data.chooserId == uid()
            && resource.data.categoryChoice == null
            && resource.data.selectionDeadline is timestamp
            && request.time < resource.data.selectionDeadline
            && changed.hasOnly(['categoryChoice'])
            && request.resource.data.categoryChoice is string
            && resource.data.categoryOptions is list
            && resource.data.categoryOptions.hasAny([request.resource.data.categoryChoice]);
        }

        allow read: if isMember(roomId);
        allow create: if isHost(roomId)
          && request.resource.data.id == roundId
          && request.resource.data.number is int
          && request.resource.data.phase == 'category_selection';
        allow update: if isHost(roomId) || chooserCategoryUpdate();
        allow delete: if isHost(roomId);

        match /bluffs/{playerId} {
          function round() {
            return get(/databases/$(database)/documents/rooms/$(roomId)/rounds/$(roundId)).data;
          }

          allow read: if isMember(roomId);
          allow create: if isMember(roomId)
            && playerId == uid()
            && roomData(roomId).status == 'playing'
            && roomData(roomId).currentRoundId == roundId
            && round().phase == 'bluffing'
            && round().bluffDeadline is timestamp
            && request.time < round().bluffDeadline
            && request.resource.data.keys().hasAll(['playerId', 'text', 'submittedAt'])
            && request.resource.data.keys().hasOnly(['playerId', 'text', 'submittedAt'])
            && request.resource.data.playerId == uid()
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 120
            && request.resource.data.submittedAt == request.time;
          allow update, delete: if false;
        }

        match /guesses/{playerId} {
          function round() {
            return get(/databases/$(database)/documents/rooms/$(roomId)/rounds/$(roundId)).data;
          }

          allow read: if isMember(roomId);
          allow create: if isMember(roomId)
            && playerId == uid()
            && roomData(roomId).status == 'playing'
            && roomData(roomId).currentRoundId == roundId
            && round().phase == 'guessing'
            && round().guessDeadline is timestamp
            && request.time < round().guessDeadline
            && request.resource.data.keys().hasAll(['playerId', 'optionId', 'submittedAt'])
            && request.resource.data.keys().hasOnly(['playerId', 'optionId', 'submittedAt'])
            && request.resource.data.playerId == uid()
            && request.resource.data.optionId is string
            && request.resource.data.submittedAt == request.time
            && round().options is map
            && round().options.keys().hasAny([request.resource.data.optionId])
            && !(
              round().options[request.resource.data.optionId].type == 'bluff'
              && (
                (round().options[request.resource.data.optionId].authorIds is list
                  && round().options[request.resource.data.optionId].authorIds.hasAny([uid()]))
                || round().options[request.resource.data.optionId].authorId == uid()
              )
            );
          allow update, delete: if false;
        }

        match /revealReady/{playerId} {
          function round() {
            return get(/databases/$(database)/documents/rooms/$(roomId)/rounds/$(roundId)).data;
          }

          allow read: if isMember(roomId);
          allow create: if isMember(roomId)
            && playerId == uid()
            && roomData(roomId).status == 'playing'
            && roomData(roomId).currentRoundId == roundId
            && round().phase == 'reveal'
            && request.resource.data.keys().hasAll(['playerId', 'ready', 'submittedAt'])
            && request.resource.data.keys().hasOnly(['playerId', 'ready', 'submittedAt'])
            && request.resource.data.playerId == uid()
            && request.resource.data.ready == true
            && request.resource.data.submittedAt == request.time;
          allow update, delete: if false;
        }
      }

      match /messages/{messageId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId)
          && request.resource.data.keys().hasAll(['authorId', 'name', 'avatar', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['authorId', 'name', 'avatar', 'text', 'createdAt'])
          && request.resource.data.authorId == uid()
          && validName(request.resource.data.name)
          && validAvatar(request.resource.data.avatar)
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 140
          && request.resource.data.text.matches('^\\S+(\\s+\\S+){0,9}$')
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
